{
  "name": "Computación Avanzada - Apps y Proyecto Final",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "privileged": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y python3-pip && python -m pip install --user -r requirements.txt && python -m pip install --user -r proyecto_final_consumo/requirements.txt",
  "forwardPorts": [8501, 8000],
  "portsAttributes": {
    "8501": {
      "label": "Aplicaciones Streamlit",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8000": {
      "label": "Proyecto final - FastAPI",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "proyecto_final_consumo/README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
