{
  "name": "Proyecto final - FastAPI y Docker",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "postCreateCommand": "cd proyecto_final_consumo && python -m pip install --user -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Proyecto final - FastAPI",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "proyecto_final_consumo/README.md",
        "proyecto_final_consumo/app/main.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
