# Configura estos valores como Codespaces secrets o copia este archivo a .env local.
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

# Valores sugeridos para el proyecto de temperatura; cámbialos si tu bucket usa otros.
INFLUX_MEASUREMENT=sensores
INFLUX_FIELD=temperatura

# Usa true solo para probar la app sin datos ni credenciales reales.
DEMO_MODE=true
